rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Dane studenta: odczyt i aktualizacja dla aplikacji rodzinnej
    match /students/{studentId} {
      allow read, write: if true;
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    // 2. Powiązania użytkowników z profilem Librus: dla właściciela konta lub sesji web
    match /user_connections/{userId} {
      allow read, write: if request.auth == null || request.auth.uid == userId;
    }

    // 3. Rejestr zapytań Librus (Access Log): odczyt dla zalogowanych, zapis tylko przez backend
    match /librus_query_logs/{logId} {
      allow read: if true;
      allow write: if false;
    }

    // 4. Sesje ciasteczek Librus i stan blokad rate-limit: całkowicie zablokowane przed klientem
    match /librus_sessions/{login} {
      allow read, write: if false;
    }
    match /system_status/{statusId} {
      allow read, write: if false;
    }

    // 5. Wnioski o e-usprawiedliwienia: odczyt i zapis dla członków rodziny
    match /justification_requests/{requestId} {
      allow read, write: if true;
    }

    // 6. Czat rodzinny: wiadomości w czasie rzeczywistym dla członków rodziny
    match /family_chats/{familyId} {
      allow read, write: if true;
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // 7. Zadania rodzinne (Smart To-Do): odczyt, tworzenie i edycja dla członków rodziny (D-01, D-03)
    match /family_tasks/{familyId} {
      allow read, write: if true;
      match /tasks/{taskId} {
        allow read, create, update: if true;
        allow delete: if !(request.auth != null &&
          request.auth.token.get('role', '') == 'student' &&
          resource.data.get('createdByRole', '') == 'parent');
      }
    }

    // Domyślna blokada pozostałych kolekcji
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
