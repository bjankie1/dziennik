rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Dane studenta: odczyt i aktualizacja tylko dla zalogowanych użytkowników Firebase Auth
    match /students/{studentId} {
      allow read, write: if request.auth != null;
      match /{allChildren=**} {
        allow read, write: if request.auth != null;
      }
    }

    // 2. Powiązania użytkowników z profilem Librus: tylko dla właściciela konta
    match /user_connections/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 3. Rejestr zapytań Librus (Access Log): odczyt tylko dla zalogowanych, zapis tylko przez backend
    match /librus_query_logs/{logId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 4. Sesje ciasteczek Librus i stan blokad rate-limit: całkowicie zablokowane przed klientem
    match /librus_sessions/{login} {
      allow read, write: if false;
    }
    match /system_status/{statusId} {
      allow read, write: if false;
    }

    // Domyślna blokada pozostałych kolekcji
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
